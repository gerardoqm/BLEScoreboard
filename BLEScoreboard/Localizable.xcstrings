    "Hundredths" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Centésimas"
          }
        }
      }
    },
    "default period unit" : {
      "comment" : "What a match unit is called until the user types another name",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Period"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiempo"
          }
        }
      }
    },
    "In the last minute of a period the board adds hundredths of a second to the clock while it runs. Needs board firmware 1.6.1." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En el último minuto de un periodo la placa añade centésimas de segundo al reloj mientras corre. Necesita el firmware 1.6.1 de la placa."
          }
        }
      }
    },
    "Syncing" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sincronizando"
          }
        }
