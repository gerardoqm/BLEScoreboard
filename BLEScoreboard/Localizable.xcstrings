          }
        }
      }
    },
    "Game start alert": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alerta de inicio del partido"
          }
        }
      }
    },
    "Period start alert": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alerta de inicio de periodo"
